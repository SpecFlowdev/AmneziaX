# Both build stages are pinned to the machine doing the building, never to the
# image's target platform. Without that, `docker buildx --platform
# linux/arm64` runs npm, Vite and every Go compile under QEMU emulation, and a
# multi-arch release build takes hours instead of minutes.
#
# Nothing here needs to run on the target: the UI bundle is just files, and Go
# cross-compiles natively. Only the final stage is target-platform, and all it
# does is copy binaries in.

# The UI is compiled first so the Go build can embed it into the binary. Its
# output is architecture-independent, so one build serves every platform.
FROM --platform=$BUILDPLATFORM node:22-alpine AS ui
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build -- --outDir /ui/dist --emptyOutDir

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=ui /ui/dist ./internal/webui/dist
ARG VERSION=dev
ARG COMMIT=unknown
# TARGETARCH is supplied by buildx for each platform being produced.
ARG TARGETARCH
ENV LDFLAGS="-s -w -X github.com/SpecFlowdev/AmneziaX/internal/version.Version=${VERSION} -X github.com/SpecFlowdev/AmneziaX/internal/version.Commit=${COMMIT}"
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags "$LDFLAGS" -o /out/amneziax-panel ./cmd/panel

# The agent binaries ship inside the panel image so a fresh node can install
# itself with nothing but curl — no Go toolchain, no Docker, no registry.
RUN set -eux; \
    for arch in amd64 arm64; do \
      CGO_ENABLED=0 GOOS=linux GOARCH="$arch" \
        go build -trimpath -ldflags "$LDFLAGS" -o "/out/dist/amneziax-node-linux-$arch" ./cmd/node; \
    done

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -u 10001 amneziax
COPY --from=build /out/amneziax-panel /usr/local/bin/amneziax-panel
COPY --from=build /out/dist /usr/local/share/amneziax/dist
USER amneziax
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/amneziax-panel"]
